# Supabase Postgres — Strategy D image for Railway
# All secrets are placeholders; real values come from Railway env vars at runtime.

# Postgres core
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# JWT settings (read by 99-jwt.sql to set DB-level app.settings.jwt_secret)
JWT_SECRET=replace-me-min-32-chars
JWT_EXP=3600

# Railway volume mount path (Railway provides this automatically when a volume is attached)
# RAILWAY_VOLUME_MOUNT_PATH=/var/lib/postgresql/data
# PGDATA is set in the Dockerfile to /var/lib/postgresql/data/pgdata
